# ─── LLM Configuration ───
# Model identifier (LiteLLM format). Examples:
#   openai/gpt-4o-mini                  (OpenAI)
#   anthropic/claude-sonnet-4-20250514  (Anthropic)
#   gemini/gemini-2.5-flash             (Google)
#   ollama/llama3.2                     (Local Ollama)
LLM_MODEL=openai/gpt-4o-mini
# Optional dedicated Critic/Judge model for escalated checks (defaults to LLM_MODEL)
# JUDGE_MODEL=openai/gpt-4o
# Optional dedicated Vision model for photos, screenshots, GIFs, and scanned PDFs (defaults to LLM_MODEL)
# VISION_MODEL=openai/gpt-4o-mini

# Provider API keys (set the one matching your model)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# ─── Database ───
# Default: SQLite file in current directory
# For PostgreSQL: postgresql+psycopg://cluestate:your_password@localhost:5432/cluestate
DATABASE_URL=sqlite+aiosqlite:///./cluestate.db
# Required when running PostgreSQL via Docker Compose
POSTGRES_PASSWORD=

# ─── Server & Platform ───
HOST=127.0.0.1
PORT=8000
# Docker Compose host interface binding (127.0.0.1 for local/reverse-proxy, 0.0.0.0 to expose directly)
HOST_BIND=127.0.0.1
LOG_LEVEL=info
APP_URL=http://localhost:8000
# CORS origins: '*' for all web clients/integrations, or comma-separated origins (e.g. https://app.cluestate.com,https://app.coevoapps.com)
CORS_ORIGINS=*

# ─── Security & Authentication ───
# Required in Docker Compose. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Allow additional public user signups after the first admin account is created (default: false)
ALLOW_SIGNUP=false
# Optional static master key for single-tenant CLI automation
# API_KEY=

# ─── Hosted Guardrails (0 = unlimited for local self-hosting) ───
RATE_LIMIT_INGEST_PER_MIN=0
MAX_INGESTS_PER_WORKSPACE_MONTH=0

# ─── Persistent Media Storage & Async Queue Worker ───
# In Coolify / Docker, mount /app/uploads as Persistent Storage and set UPLOAD_DIR=/app/uploads
UPLOAD_DIR=./uploads
STORE_UPLOADED_MEDIA=true
MAX_UPLOAD_SIZE_MB=10
ENABLE_INGEST_WORKER=true
