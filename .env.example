# ─── LLM Configuration ───
# Model identifier (LiteLLM format). Examples:
#   openai/gpt-4o-mini                  (OpenAI)
#   anthropic/claude-3-5-sonnet-20241022 (Anthropic)
#   gemini/gemini-2.0-flash             (Google)
#   ollama/llama3                       (Local Ollama)
LLM_MODEL=openai/gpt-4o-mini

# Provider API keys (set the one matching your model)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# ─── Database ───
# Default: SQLite file in current directory
# For PostgreSQL: postgresql+psycopg://cluestate:your_password@localhost:5432/cluestate
DATABASE_URL=sqlite+aiosqlite:///./cluestate.db
POSTGRES_PASSWORD=your_secure_postgres_password

# ─── Server & Platform ───
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
APP_URL=https://app.cluestate.com
CORS_ORIGINS=https://app.cluestate.com,https://cluestate.com,http://localhost:5173,http://localhost:8000

# ─── Security & Authentication ───
# Strong secret used to sign JWT session tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=replace-with-a-strong-random-secret
# Optional static master key for single-tenant CLI automation
# API_KEY=
