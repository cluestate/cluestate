# ─── LLM Configuration ───
# Model identifier (LiteLLM format). Examples:
#   openai/gpt-4o-mini          (OpenAI)
#   anthropic/claude-3-5-sonnet (Anthropic)
#   gemini/gemini-2.0-flash     (Google)
#   ollama/llama3               (Local Ollama)
LLM_MODEL=openai/gpt-4o-mini

# Provider API keys (set only the one you need)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# ─── Database ───
# Default: SQLite file in current directory (zero-config)
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/cluestate
DATABASE_URL=sqlite+aiosqlite:///./cluestate.db

# ─── Server ───
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ─── Security ───
# Optional: Require API key for all requests
# API_KEY=your-secret-api-key
