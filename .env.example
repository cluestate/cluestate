# ─── LLM Configuration ───
# Model identifier (LiteLLM format). Examples:
#   openai/gpt-4o-mini                  (OpenAI)
#   anthropic/claude-3-5-sonnet-20241022 (Anthropic)
#   gemini/gemini-2.0-flash             (Google)
#   ollama/llama3                       (Local Ollama)
LLM_MODEL=openai/gpt-4o-mini

# Provider API keys (set the one matching your model)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# ─── Database ───
# Default: SQLite file in current directory
# For PostgreSQL: postgresql+psycopg://cluestate:your_password@localhost:5432/cluestate
DATABASE_URL=sqlite+aiosqlite:///./cluestate.db
# Required when running PostgreSQL via Docker Compose
POSTGRES_PASSWORD=

# ─── Server & Platform ───
HOST=0.0.0.0
PORT=8000
# Docker Compose host interface binding (127.0.0.1 for local/reverse-proxy, 0.0.0.0 to expose directly)
HOST_BIND=127.0.0.1
LOG_LEVEL=info
APP_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# ─── Security & Authentication ───
# Required in Docker Compose. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Optional static master key for single-tenant CLI automation
# API_KEY=
